{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./.cursor/hooks/production-guard.sh",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./.cursor/hooks/mcp-guard.sh",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}